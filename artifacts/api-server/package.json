{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "pnpm --filter @workspace/db run migrate:erp-hr && pnpm --filter @workspace/db run migrate:erp-document-creators && pnpm --filter @workspace/db run migrate:social-marketing && pnpm --filter @workspace/db run migrate:newsletter && pnpm --filter @workspace/db run migrate:cmo && node --enable-source-maps ./dist/index.mjs",
    "pretypecheck": "cd ../.. && pnpm run typecheck:libs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:admin-content": "env -u OPENAI_API_KEY tsx --test src/routes/adminContent.integration.test.ts src/routes/adminContent.ui-contract.test.ts",
    "test:assistant-auth": "tsx --test src/lib/assistantTools.integration.test.ts",
    "test:cmo": "tsx --test src/lib/cmoScheduler.test.ts",
    "test:content-restore": "tsx --test --test-concurrency=1 src/routes/adminContent.restore.test.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.0.2",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "openai": "^6.27.0"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
