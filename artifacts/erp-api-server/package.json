{
  "name": "@workspace/erp-api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:build-safety": "node --test tests/build-safety.node.mjs",
    "test:customers:postgres-isolated": "node tests/customer-postgres-isolated.runner.mjs",
    "test:order-documents:postgres-isolated": "node tests/order-documents-postgres-isolated.runner.mjs",
    "test:integration:documents": "node tests/document-draft-edit.integration.mjs",
    "test:integration:virtual-order": "node tests/virtual-order-completion.integration.mjs",
    "test:integration:virtual-switch": "node tests/item-virtual-switch.integration.mjs",
    "test:integration:credit-note-journal": "node tests/credit-note-auto-journal.integration.mjs",
    "test:bi:postgres-isolated": "node tests/bi-postgres-isolated.runner.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource/noto-sans-tc": "^5.3.1",
    "@google-cloud/storage": "^8.2.0",
    "@google/genai": "^2.23.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opentelemetry/api": "^1.10.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.118.0",
    "@workspace/erp-api-zod": "workspace:*",
    "@workspace/erp-db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "pdf-lib": "^1.17.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "puppeteer-core": "^25.18.1",
    "stripe": "^22.6.2",
    "stripe-replit-sync": "^1.0.0",
    "subset-font": "^2.9.0",
    "unpdf": "^1.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "@types/node-cron": "^3.0.11",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.11"
  }
}
