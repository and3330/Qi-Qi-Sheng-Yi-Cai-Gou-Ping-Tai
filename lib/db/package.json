{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "enable:vector": "node scripts/enable-vector.mjs",
    "test:vector": "node --test scripts/enable-vector.test.mjs",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "migrate:finance-wallet": "node scripts/migrate-finance-wallet.mjs",
    "migrate:erp-inventory": "node scripts/migrate-erp-inventory.mjs",
    "migrate:linktree": "node scripts/migrate-linktree.mjs",
    "migrate:erp-accounting": "node scripts/migrate-erp-accounting.mjs",
    "migrate:social-marketing": "node scripts/migrate-social-marketing.mjs",
    "migrate:newsletter": "node scripts/migrate-newsletter.mjs",
    "migrate:cmo": "node scripts/migrate-cmo.mjs",
    "migrate:erp-hr": "node scripts/migrate-erp-hr.mjs",
    "migrate:erp-crm": "node scripts/migrate-erp-crm.mjs",
    "migrate:erp-projects": "node scripts/migrate-erp-projects.mjs",
    "migrate:erp-contracts": "node scripts/migrate-erp-contracts.mjs",
    "migrate:erp-misc": "node scripts/migrate-erp-misc.mjs",
    "migrate:erp-notifications": "node scripts/migrate-erp-notifications.mjs",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
